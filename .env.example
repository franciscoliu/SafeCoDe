# SafeCoDe environment configuration.
#
#   cp .env.example .env    then fill in the values you need.
#
# .env is gitignored. Never commit real keys.
# Anything exported in your shell takes precedence over this file.

# ---------------------------------------------------------------------------
# Required only for the GPT-4o judge (the default) and for benchmark scoring.
# Run with `--judge qwen` to skip this entirely and stay fully local.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# Optional: route through a proxy or an OpenAI-compatible gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Judge models (Stage 2 of SafeCoDe). Defaults reproduce the paper.
# ---------------------------------------------------------------------------
# SAFECODE_CAPTION_MODEL=gpt-4o
# SAFECODE_JUDGE_MODEL=gpt-4o
# SAFECODE_QWEN_JUDGE_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ---------------------------------------------------------------------------
# Benchmark scoring models (grade generated responses; not part of the method).
# ---------------------------------------------------------------------------
# SAFECODE_EVAL_MODEL=gpt-4.1-mini
# SAFECODE_MSS_JUDGE_MODEL=gpt-4.1-nano
# SAFECODE_MOSS_JUDGE_MODEL=gpt-4-turbo

# ---------------------------------------------------------------------------
# Where to cache downloaded model weights. Useful on clusters where $HOME is
# small -- point this at scratch. Falls back to ~/.cache/huggingface.
# ---------------------------------------------------------------------------
# HF_HOME=/path/to/your/hf_cache
# SAFECODE_MODEL_CACHE_DIR=/path/to/your/hf_cache

# Needed only for gated Hugging Face models or datasets.
# HF_TOKEN=

# Restrict which GPUs are visible, e.g. CUDA_VISIBLE_DEVICES=0
# CUDA_VISIBLE_DEVICES=
